# Copy to .env on the server (never commit .env).

# Flask session key. Signs the OAuth state cookie, so it must be identical
# across gunicorn workers. If unset the app persists a random one to
# $MYSELF_DATA/.secret_key instead — set it explicitly in production.
SECRET_KEY=

# Public URL of this deployment. OAuth callbacks are registered against it, so
# it must match what the browser sees.
BASE_URL=https://myself.social

# Where accounts, actor documents and private signing keys live. The container
# mounts /var/lib/myself here; leave as-is unless you know why.
MYSELF_DATA=/data
